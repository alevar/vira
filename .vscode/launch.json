{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "vira debug",
            "type": "debugpy",
            "request": "launch",
            "module": "vira",
            "console": "integratedTerminal",
            "args": [
                "--annotation", "${workspaceFolder}/data/reference.gtf",
                "--genome", "${workspaceFolder}/data/reference.fasta",
                "--target", "${workspaceFolder}/data/target.fasta",
                "--output", "${workspaceFolder}/data/output.gtf",
                "--sam2gtf", "${workspaceFolder}/soft/sam2gtf",
                "--miniprot", "${workspaceFolder}/soft/miniprot",
            ],
        },
        {
            "name": "vira debug atlas",
            "type": "debugpy",
            "request": "launch",
            "module": "vira",
            "console": "integratedTerminal",
            "args": [
                "--annotation", "${workspaceFolder}/../HIV_Atlas_Creation/data/reference/K03455.1.gtf",
                "--genome", "${workspaceFolder}/../HIV_Atlas_Creation/data/reference/K03455.1.fasta",
                "--target", "${workspaceFolder}/../HIV_Atlas_Creation/data/sequences/KT284371.1.fasta",
                "--output", "${workspaceFolder}/output/KT284371.1.gtf",
                "--sam2gtf", "${workspaceFolder}/../HIV_Atlas_Creation/soft/sam2gtf/target/release/sam2gtf",
                "--miniprot", "${workspaceFolder}/../HIV_Atlas_Creation/soft/miniprot/miniprot",
                "--snapper", "snapper",
                "--tmp-dir","${workspaceFolder}/tmp.KT284371.1",
                "--guide","${workspaceFolder}/../HIV_Atlas_Creation/data/sequences/KT284371.1.gtf",
                "--force-cds",
            ],
        }
    ]
}
  